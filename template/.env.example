# Session cookie signing secret (replace with a random 32+ character string in production)
AUTH_SECRET=replace-with-a-random-32-char-secret

# Optional: Set true only if serving HTTPS in production behind TLS
COOKIE_SECURE=false

# Demo account credentials for One-Click Demo Sign In
DEMO_USER_EMAIL=demo@skeleton.dev
DEMO_USER_PASSWORD=spooky-demo

# Optional OpenAI-compatible AI settings.
# Leave AI_API_KEY empty to run in built-in Demo Mode with simulated streaming.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
